# ==============================================================================
# Variables de entorno — GAFER Monorepo
# ==============================================================================

# Backend (apps/api)
PORT=3000
DATABASE_URL=postgresql://gafer:gafer@localhost:5432/gafer?schema=public

# Worker & Colas (apps/worker)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO local / S3) para PDFs y fotos de campo
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=gafer
MINIO_ROOT_PASSWORD=gafersecret
MINIO_BUCKET=gafer-archivos

# Frontend Web (apps/web)
VITE_API_URL=http://localhost:3000

# Mobile (apps/mobile)
# En emulador de Android Studio usar 10.0.2.2 para apuntar al localhost de tu PC
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
